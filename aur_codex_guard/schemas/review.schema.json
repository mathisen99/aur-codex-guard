{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["allow", "warn", "block"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "evidence": { "type": "string" },
          "reason": { "type": "string" },
          "recommendation": { "type": "string" }
        },
        "required": [
          "severity",
          "title",
          "file",
          "line",
          "evidence",
          "reason",
          "recommendation"
        ],
        "additionalProperties": false
      }
    },
    "reviewed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "verdict",
    "confidence",
    "summary",
    "findings",
    "reviewed_files",
    "limitations"
  ],
  "additionalProperties": false
}
